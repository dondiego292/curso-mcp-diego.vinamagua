# Configuración de Seguridad
# Generar una clave segura con: openssl rand -hex 32
SECRET_KEY=cambiar_por_una_clave_secreta_criptografica_segura_de_32_bytes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Base de Datos (SQLite para desarrollo local, PostgreSQL para producción)
DATABASE_URL=sqlite:///./gastos.db

# Configuración MCP (Usuario demo solo para transporte stdio sin identidad propagable)
DEMO_USER_ID=1
